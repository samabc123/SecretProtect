DATA_SOURCE=mock
EVENTS_SOURCE=sqlite
MONITORING_SOURCE=sqlite
# Environment variables are read at startup. Alternatively copy config.local.example.json
# to config.local.json and edit that local file; config.local.json is ignored by Git.
# EVENTS_DB_PATH=C:\path\to\events.sqlite3
# MONITORING_DB_PATH=C:\path\to\monitoring.sqlite3
APP_HOST=127.0.0.1
APP_PORT=8000
# Required for stage 6 controlled detection; keep outside source control.
# CREDENTIAL_HMAC_KEY=replace-with-a-random-secret-at-least-16-chars
# CONNECTOR_NETWORK_ENABLED=false
# GITHUB_TOKEN=keep-outside-repository-and-process-logs
# GITEE_TOKEN=keep-outside-repository-and-process-logs
# GITEE_API_BASE=https://gitee.com/api/v5
# WEIBO_ACCESS_TOKEN=keep-outside-repository-and-process-logs
# DOCKERHUB_USERNAME=your-docker-hub-username
# DOCKERHUB_TOKEN is intentionally not a runtime setting. A line such as
# DOCKERHUB_TOKEN=dckr_pat_... belongs to an authorized scan input; its value
# must use the documented dckr_pat_ prefix and match the bounded detector rule
# before it is classified as dockerhub_token.
# VERIFICATION_NETWORK_ENABLED=false
# VERIFICATION_TIMEOUT_SECONDS=8
# CONNECTOR_RUNS_DB_PATH=C:\path\to\connector_runs.sqlite3
# Settings are normally managed in the web UI. These paths only locate the
# local encrypted settings store and are not secrets.
# SETTINGS_DB_PATH=C:\path\to\settings.sqlite3
# SETTINGS_MASTER_KEY_PATH=C:\path\to\settings.master.key
# Samlab integration: inject a random server-only secret of at least 32 bytes.
# Leave empty until the Samlab backend adapter is deployed. Never send passwords.
SAMLAB_INTEGRATION_SECRET=
