DATA_SOURCE=sqlite
CONNECTOR_NETWORK_ENABLED=false
VERIFICATION_NETWORK_ENABLED=false
# Initial creation only. Existing admin password hashes are retained.
SECERTPROTECT_BOOTSTRAP_PASSWORD_FILE=/etc/secertprotect/bootstrap.secret
# Keep empty for loopback development. For reviewed reverse proxy deployments:
# SECERTPROTECT_PUBLIC_ORIGIN=https://security.example.org
CROWDSEC_CREDENTIALS_FILE=/etc/secertprotect/machine.yaml
CROWDSEC_BOUNCER_KEY_FILE=/etc/secertprotect/decision-reader.secret
CROWDSEC_SYNC_INTERVAL=30
CROWDSEC_ALLOW_DELETE=false
# Optional custom CA; TLS verification cannot be disabled.
# CROWDSEC_CA_FILE=/etc/secertprotect/ca.pem
# SMTP_HOST=smtp.example.org
# SMTP_PORT=465
# SMTP_FROM=security@example.org
# SMTP_TO=operator@example.org
# SMTP_USERNAME=security@example.org
# SMTP_PASSWORD_FILE=/etc/secertprotect/smtp.secret
