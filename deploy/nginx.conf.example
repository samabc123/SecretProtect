# Template only: replace domain/certificate paths and review network ACLs first.
server {
    listen 443 ssl;
    server_name security.example.org;
    ssl_certificate /etc/ssl/secertprotect/fullchain.pem;
    ssl_certificate_key /etc/ssl/secertprotect/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host security.example.org;
        # The application verifies a real authenticated session, never localhost identity.
        # Do not trust caller-supplied forwarding headers.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
    }
}
